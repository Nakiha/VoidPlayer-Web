{
  "name": "voidplayer-web",
  "private": true,
  "license": "LGPL-2.1-or-later",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test test/*.test.ts test/*.test.mjs",
    "serve": "node server/main.ts",
    "dev:web": "vite --host 127.0.0.1",
    "start": "node server/main.ts",
    "service": "node scripts/service.mjs",
    "release": "npm run build && node scripts/package-release.mjs",
    "test:release": "node scripts/check-release.mjs",
    "test:library:browser": "npm run build && node scripts/check-library-browser.mjs",
    "test:browser": "npm run build && node scripts/check-browser.mjs",
    "test:flv:browser": "npm run build && node scripts/check-flv-browser.mjs",
    "fixtures:library": "node scripts/make-library-fixtures.mjs",
    "fixtures:flv": "python3 scripts/make-flv-fixtures.py",
    "test:annotations:browser": "npm run build && node scripts/check-annotation-browser.mjs",
    "test:annotations:rendering": "npm run build && node scripts/check-annotation-rendering.mjs",
    "test:menus:browser": "npm run build && node scripts/check-menu-browser.mjs",
    "test:shortcuts:browser": "npm run build && node scripts/check-shortcuts-browser.mjs",
    "test:feedback:browser": "npm run build && node scripts/check-feedback-browser.mjs",
    "test:stepping:browser": "npm run build && node scripts/check-stepping-browser.mjs",
    "test:timeline:browser": "npm run build && node scripts/check-timeline-browser.mjs",
    "test:metadata:browser": "npm run build && node scripts/check-metadata-browser.mjs",
    "test:mark-cards:browser": "npm run build && node scripts/check-mark-cards-browser.mjs",
    "test:theme:browser": "npm run build && node scripts/check-theme-browser.mjs",
    "test:workspace:browser": "npm run build && node scripts/check-workspace-browser.mjs",
    "test:settings:browser": "npm run build && node scripts/check-settings-browser.mjs",
    "test:saved-workspaces:browser": "npm run build && node scripts/check-saved-workspaces-browser.mjs",
    "test:admin:browser": "npm run build && node scripts/check-admin-browser.mjs",
    "test:release:browser": "node scripts/check-release-browser.mjs"
  },
  "dependencies": {
    "@phosphor-icons/core": "2.1.1",
    "mediabunny": "1.55.7"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "playwright": "^1.63.0",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  },
  "description": "VoidPlayer web: local-file and library video review in the browser (WebCodecs + trimmed FFmpeg WASM fallback)",
  "engines": {
    "node": ">=24"
  }
}
