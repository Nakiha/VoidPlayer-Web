{
  "name": "voidplayer-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "serve": "node server/main.ts"
  },
  "dependencies": {
    "mediabunny": "1.55.7"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "playwright": "^1.63.0",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  },
  "description": "VoidPlayer web: local-file and library video review in the browser (WebCodecs + trimmed FFmpeg WASM fallback)"
}
