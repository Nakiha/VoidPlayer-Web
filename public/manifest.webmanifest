{
  "id": "/",
  "name": "VoidPlayer",
  "short_name": "VoidPlayer",
  "lang": "zh-CN",
  "description": "在本地播放视频、逐帧对比并导出评审标注。",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#212121",
  "theme_color": "#212121",
  "launch_handler": { "client_mode": "navigate-new" },
  "file_handlers": [{
    "action": "/?open=files",
    "launch_type": "single-client",
    "accept": {
      "application/x-voidplayer": [".voidplayer"],
      "video/mp4": [".mp4", ".m4v"],
      "video/quicktime": [".mov"],
      "video/x-matroska": [".mkv"],
      "video/webm": [".webm"],
      "video/mp2t": [".m2ts"],
      "video/mpeg": [".mpg", ".mpeg"],
      "video/x-msvideo": [".avi"],
      "video/x-flv": [".flv"]
    }
  }],
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
