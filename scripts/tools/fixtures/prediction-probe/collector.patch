+/* Progressive frame geometry only. Capture before boundary DC substitutions. */
+static inline void vp_probe_avc_mode(const H264Context *h, const H264SliceContext *sl,
+                                     int kind, int i, int size, int mode)
+{
+    if (FRAME_MBAFF(h) || h->picture_structure != PICT_FRAME || !h->cur_pic.f) return;
+    int offset = scan8[i] - scan8[0];
+    vp_probe_append((uintptr_t)h->cur_pic.f->opaque, (ProbeRow){
+        kind, sl->mb_x * 16 + 4 * (offset % 8), sl->mb_y * 16 + 4 * (offset / 8),
+        size, size, {mode}
+    });
+}
 
