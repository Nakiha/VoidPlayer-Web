+/* Shares the existing global byte budget and picture ownership. */
+void vp_probe_append(uintptr_t id, ProbeRow row)
+{
+    Picture *p = acquire_picture(id);
+    if (!p) return;
+    if (p->sealed) {
+        failure = AVERROR_INVALIDDATA;
+    } else if (p->used == p->reserved) {
+        uint32_t capacity = p->reserved ? p->reserved * 2 : 256;
+        size_t extra = (capacity - p->reserved) * sizeof(ProbeRow);
+        if (reserve_records(extra)) {
+            ProbeRow *rows = realloc(p->probe, capacity * sizeof(ProbeRow));
+            if (rows) {
+                p->probe = rows;
+                p->reserved = capacity;
+            } else {
+                allocated -= extra;
+            }
+        }
+        if (p->used == p->reserved) failure = AVERROR(ENOMEM);
+    }
+    if (!failure) p->probe[p->used++] = row;
+    UNLOCK_PICTURE(p);
+}
+int vp_probe_count(void) { return ready ? ready->used : 0; }
+intptr_t vp_probe_rows(void) { return ready ? (intptr_t)ready->probe : 0; }
